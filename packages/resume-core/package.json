{
  "name": "@hired-hand/resume-core",
  "version": "0.1.0",
  "description": "ATS-compatible resume model, validators, and DOCX/PDF/HTML/text/JSON exporters shared by the Hired Hand tools.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/zod.d.ts",
        "default": "./dist/zod.js"
      },
      "require": {
        "types": "./dist/zod.d.cts",
        "default": "./dist/zod.cjs"
      }
    },
    "./docx": {
      "import": {
        "types": "./dist/docx.d.ts",
        "default": "./dist/docx.js"
      },
      "require": {
        "types": "./dist/docx.d.cts",
        "default": "./dist/docx.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "docx": "^9.0.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "docx": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "docx": "9.7.1",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.8",
    "tsup": "8.5.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
